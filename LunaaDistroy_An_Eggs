--══════════════════════ [7] HÀM TẠO NÚT (GLARE) ══════════════════════
local BASE_COLOR   = Color3.fromRGB(25, 15, 40)
local ACTIVE_COLOR = Color3.fromRGB(8, 5, 12)
local HOVER_COLOR  = Color3.fromRGB(35, 20, 55)

local function startGlare(btn)
    local glare = btn:FindFirstChild("Glare")
    if not glare then return end
    if btn:GetAttribute("GlareRunning") then return end
    btn:SetAttribute("GlareRunning", true)
    glare.Visible = true

    task.spawn(function()
        while btn:GetAttribute("Active") and btn:GetAttribute("GlareRunning") do
            glare.Position = UDim2.new(0, -100, -0.5, 0)
            local tw = TweenService:Create(glare, TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {Position = UDim2.new(1, 100, -0.5, 0)})
            tw:Play()
            tw.Completed:Wait()
            if btn:GetAttribute("Active") then
                task.wait(0.8)
            end
        end
        glare.Visible = false
        glare.Position = UDim2.new(0, -100, -0.5, 0)
        btn:SetAttribute("GlareRunning", false)
    end)
end

local function mkBtn(text, posY, parent)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -24, 0, 32)
    b.Position = UDim2.new(0.5, 0, 0, posY)
    b.AnchorPoint = Vector2.new(0.5, 0)
    b.BackgroundColor3 = BASE_COLOR
    b.Text = text
    b.Font = Enum.Font.GothamBold
    b.TextSize = 14
    b.TextColor3 = Color3.fromRGB(220, 180, 255)
    b.TextStrokeTransparency = 0.8
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.ClipsDescendants = true 
    b.Parent = parent
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
    
    local bStroke = Instance.new("UIStroke", b)
    bStroke.Color = Color3.fromRGB(100, 40, 180) 
    bStroke.Thickness = 1
    bStroke.Transparency = 0.4

    local glare = Instance.new("Frame")
    glare.Name = "Glare"
    glare.Size = UDim2.new(0, 15, 2, 0) 
    glare.Position = UDim2.new(0, -100, -0.5, 0)
    glare.Rotation = 115 
    glare.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    glare.BackgroundTransparency = 0.5
    glare.BorderSizePixel = 0
    glare.ZIndex = 2
    glare.Visible = false
    glare.Parent = b

    local gGrad = Instance.new("UIGradient", glare)
    gGrad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(0.3, 1),
        NumberSequenceKeypoint.new(0.5, 0.85),
        NumberSequenceKeypoint.new(0.7, 1),
        NumberSequenceKeypoint.new(1, 1)
    })

    b.MouseEnter:Connect(function()
        if not b:GetAttribute("Active") then
            TweenService:Create(b, TweenInfo.new(0.2), {BackgroundColor3 = HOVER_COLOR}):Play()
        end
    end)
    b.MouseLeave:Connect(function()
        if not b:GetAttribute("Active") then
            TweenService:Create(b, TweenInfo.new(0.2), {BackgroundColor3 = BASE_COLOR}):Play()
        end
    end)
    
    b:SetAttribute("Active", false)
    b:SetAttribute("GlareRunning", false)
    return b
end

local function setBtnActive(btn, isActive)
    btn:SetAttribute("Active", isActive)
    TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = isActive and ACTIVE_COLOR or BASE_COLOR}):Play()
    if isActive then
        startGlare(btn)
    end
end

