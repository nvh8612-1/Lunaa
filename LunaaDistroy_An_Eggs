local function mkBtn(text, posY)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -16, 0, 28)
    b.Position = UDim2.new(0.5, 0, 0, posY)
    b.AnchorPoint = Vector2.new(0.5, 0)
    b.BackgroundColor3 = Color3.fromRGB(15, 25, 40)
    b.Text = text
    b.Font = Enum.Font.GothamSemibold
    b.TextSize = 13
    b.TextColor3 = Color3.fromRGB(200, 240, 255)
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.Parent = body
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)

    local bStroke = Instance.new("UIStroke", b)
    bStroke.Color = Color3.fromRGB(0, 255, 255)
    bStroke.Thickness = 1
    bStroke.Transparency = 0.3

    b.MouseEnter:Connect(function()
        TweenService:Create(bStroke, TweenInfo.new(0.2), {Thickness = 2, Transparency = 0}):Play()
        TweenService:Create(b, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(30, 50, 80)}):Play()
    end)
    b.MouseLeave:Connect(function()
        TweenService:Create(bStroke, TweenInfo.new(0.2), {Thickness = 1, Transparency = 0.3}):Play()
        TweenService:Create(b, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(15, 25, 40)}):Play()
    end)
    return b
end

