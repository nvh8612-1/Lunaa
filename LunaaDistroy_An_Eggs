local function mkBtn(text, posY)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -24, 0, 32)
    b.Position = UDim2.new(0.5, 0, 0, posY)
    b.AnchorPoint = Vector2.new(0.5, 0)
    b.BackgroundColor3 = Color3.fromRGB(25, 15, 40)
    b.Text = text
    b.Font = Enum.Font.GothamBold
    b.TextSize = 14
    b.TextColor3 = Color3.fromRGB(220, 180, 255)
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.Parent = body
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)

    local bStroke = Instance.new("UIStroke", b)
    bStroke.Color = Color3.fromRGB(150, 50, 255)
    bStroke.Thickness = 1
    bStroke.Transparency = 0.4

    local bGrad = Instance.new("UIGradient", bStroke)
    bGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(0, 255, 255)), 
        ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 0, 255))  
    })
    bGrad.Enabled = false

    b.MouseEnter:Connect(function()
        TweenService:Create(bStroke, TweenInfo.new(0.2), {Thickness = 2, Transparency = 0}):Play()
        TweenService:Create(b, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(45, 25, 70)}):Play()
        bGrad.Enabled = true
    end)
    b.MouseLeave:Connect(function()
        if not b:GetAttribute("Active") then
            TweenService:Create(bStroke, TweenInfo.new(0.2), {Thickness = 1, Transparency = 0.4}):Play()
            TweenService:Create(b, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(25, 15, 40)}):Play()
            bGrad.Enabled = false
        end
    end)
    b:SetAttribute("Active", false)
    return b
end

