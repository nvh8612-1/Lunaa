local function clearEggs()
    for _, data in ipairs(activeEggs) do
        if data.highlight then data.highlight:Destroy() end
        if data.billboard then data.billboard:Destroy() end
    end
    activeEggs = {}
end

local function scanEggs()
    clearEggs()
    if not opHugeEnabled then return end

    local ZoneBuilds = Workspace:FindFirstChild("Build") and Workspace.Build:FindFirstChild("ZoneBuilds")
    if not ZoneBuilds then return end

    for _, zone in ipairs(ZoneBuilds:GetChildren()) do
        if selectedZones[zone.Name] then
            local eggsFolder = zone:FindFirstChild("Eggs")
            if eggsFolder then
                for _, egg in ipairs(eggsFolder:GetChildren()) do
                    if egg:IsA("Model") or egg:IsA("BasePart") then
                        local hl = Instance.new("Highlight")
                        hl.FillTransparency = 1
                        hl.OutlineColor = Color3.new(1, 1, 1)
                        hl.OutlineTransparency = 0
                        hl.Adornee = egg
                        hl.Parent = egg
                        hl.Enabled = false

                        local bb = Instance.new("BillboardGui")
                        bb.Size = UDim2.new(0, 120, 0, 40)
                        bb.StudsOffset = Vector3.new(0, 3, 0)
                        bb.AlwaysOnTop = true
                        bb.Adornee = egg
                        bb.Enabled = false

                        local txt = Instance.new("TextLabel")
                        txt.Size = UDim2.new(1, 0, 1, 0)
                        txt.BackgroundTransparency = 1
                        txt.Text = "HUGE"
                        txt.TextColor3 = Color3.fromRGB(255, 255, 255)
                        txt.TextStrokeTransparency = 0
                        txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                        txt.Font = Enum.Font.GothamBlack
                        txt.TextScaled = false 
                        txt.TextSize = 22 
                        txt.Parent = bb
                        bb.Parent = egg

                        table.insert(activeEggs, {egg = egg, highlight = hl, billboard = bb})
                    end
                end
            end
        end
    end
end

