--══════════════════════ [11] LOGIC OP HUGE (70 STUDS + WEIGHT KG) ══════════════════════
local function clearEggs()
    for _, data in ipairs(activeEggs) do
        if data.highlight then data.highlight:Destroy() end
        if data.billboard then data.billboard:Destroy() end
    end
    activeEggs = {}
end

local function scanEggs()
    clearEggs()
    if not opHugeEnabled then return end

    local ZoneBuilds = Workspace:FindFirstChild("Build") and Workspace.Build:FindFirstChild("ZoneBuilds")
    if not ZoneBuilds then return end

    local seenEggs = {}

    for _, zone in ipairs(ZoneBuilds:GetChildren()) do
        if selectedZones[zone.Name] then
            local eggsFolder = zone:FindFirstChild("Eggs")
            if eggsFolder then
                for _, obj in ipairs(eggsFolder:GetDescendants()) do
                    local isHuge = false
                    local wb = obj:GetAttribute("WeightBracket")
                    
                    if wb == "HUGE" then
                        isHuge = true
                    else
                        local wbObj = obj:FindFirstChild("WeightBracket")
                        if wbObj and wbObj:IsA("StringValue") and wbObj.Value == "HUGE" then
                            isHuge = true
                        end
                    end

                    if isHuge then
                        local weightKg = 0
                        local wkAttr = obj:GetAttribute("WeightKg")
                        if wkAttr then
                            weightKg = wkAttr
                        else
                            local wkObj = obj:FindFirstChild("WeightKg")
                            if wkObj and (wkObj:IsA("NumberValue") or wkObj:IsA("StringValue")) then
                                weightKg = wkObj.Value
                            end
                        end

                        local targetModel = obj
                        local parentModel = obj:FindFirstAncestorOfClass("Model")
                        if parentModel and parentModel ~= eggsFolder and parentModel.Name ~= "Eggs" and parentModel.Name ~= zone.Name then
                            targetModel = parentModel
                        end

                        if not seenEggs[targetModel] then
                            seenEggs[targetModel] = true

                            for _, child in ipairs(targetModel:GetChildren()) do
                                if child.Name == "HugeHighlight" or child.Name == "HugeBillboard" then
                                    child:Destroy()
                                end
                            end

                            local hl = Instance.new("Highlight")
                            hl.Name = "HugeHighlight"
                            hl.FillTransparency = 1
                            hl.OutlineColor = Color3.new(1, 1, 1)
                            hl.OutlineTransparency = 0
                            hl.Adornee = targetModel
                            hl.Parent = targetModel
                            hl.Enabled = false

                            local bb = Instance.new("BillboardGui")
                            bb.Name = "HugeBillboard"
                            bb.Size = UDim2.new(0, 150, 0, 60) 
                            bb.StudsOffset = Vector3.new(0, 3, 0)
                            bb.AlwaysOnTop = true
                            bb.Adornee = targetModel
                            bb.Enabled = false

                            local txtWeight = Instance.new("TextLabel")
                            txtWeight.Size = UDim2.new(1, 0, 0.5, 0)
                            txtWeight.Position = UDim2.new(0, 0, 0, 0)
                            txtWeight.BackgroundTransparency = 1
                            txtWeight.Text = tostring(weightKg) .. "KG"
                            txtWeight.TextColor3 = Color3.fromRGB(255, 255, 255)
                            txtWeight.TextStrokeTransparency = 0
                            txtWeight.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                            txtWeight.Font = Enum.Font.GothamBlack
                            txtWeight.TextScaled = false 
                            txtWeight.TextSize = 20 
                            txtWeight.Parent = bb

                            local txtHuge = Instance.new("TextLabel")
                            txtHuge.Size = UDim2.new(1, 0, 0.5, 0)
                            txtHuge.Position = UDim2.new(0, 0, 0.5, 0)
                            txtHuge.BackgroundTransparency = 1
                            txtHuge.Text = "HUGE"
                            txtHuge.TextColor3 = Color3.fromRGB(255, 255, 255)
                            txtHuge.TextStrokeTransparency = 0
                            txtHuge.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                            txtHuge.Font = Enum.Font.GothamBlack
                            txtHuge.TextScaled = false 
                            txtHuge.TextSize = 22 
                            txtHuge.Parent = bb

                            bb.Parent = targetModel
                            table.insert(activeEggs, {egg = targetModel, highlight = hl, billboard = bb})
                        end
                    end
                end
            end
        end
    end
end

task.spawn(function()
    while task.wait(0.1) do
        if not opHugeEnabled then continue end
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            for _, data in ipairs(activeEggs) do
                if data.egg and data.egg.Parent then
                    local eggPos = data.egg:GetPivot().Position
                    local dist = (hrp.Position - eggPos).Magnitude
                    local shouldShow = dist <= 70
                    
                    if data.highlight then data.highlight.Enabled = shouldShow end
                    if data.billboard then data.billboard.Enabled = shouldShow end
                end
            end
        end
    end
end)

