--══════════════════════ [15] LOGIC TWEEN LUNAA & LINE (BEAM) ══════════════════════
local activeTween, hum, origSpeed = nil, nil, nil
local isTweening = false
local lineOn = false

-- Tạo Part mỏ neo ẩn tại tọa độ
local anchorPart = Instance.new("Part")
anchorPart.Name = "LunaaLineAnchor"
anchorPart.Size = Vector3.new(1,1,1)
anchorPart.Position = TARGET
anchorPart.Anchored = true
anchorPart.CanCollide = false
anchorPart.Transparency = 1
anchorPart.Parent = Workspace

local anchorAttachment = Instance.new("Attachment")
anchorAttachment.Parent = anchorPart

local currentBeam = nil
local charAttachment = nil

local function updateLine()
    if not lineOn then return end
    local char = player.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    -- Nếu chưa có Attachment trên người thì tạo mới
    if not charAttachment or charAttachment.Parent ~= root then
        if charAttachment then charAttachment:Destroy() end
        charAttachment = Instance.new("Attachment")
        charAttachment.Name = "LunaaLineStart"
        charAttachment.Parent = root
    end
    
    -- Nếu Beam chưa có thì tạo
    if not currentBeam or currentBeam.Parent ~= root then
        if currentBeam then currentBeam:Destroy() end
        currentBeam = Instance.new("Beam")
        currentBeam.Name = "LunaaLineBeam"
        currentBeam.FaceCamera = true
        currentBeam.AlwaysOnTop = true
        currentBeam.Color = ColorSequence.new(Color3.new(1, 1, 1))
        currentBeam.LightEmission = 1
        currentBeam.LightInfluence = 0
        currentBeam.Width0 = 0.2
        currentBeam.Width1 = 0.2
        currentBeam.Parent = root
    end
    
    -- Cập nhật 2 đầu của Beam
    currentBeam.Attachment0 = charAttachment
    currentBeam.Attachment1 = anchorAttachment
end

RunService.RenderStepped:Connect(updateLine)

local function stopTween()
    isTweening = false
    if activeTween then activeTween:Cancel(); activeTween = nil end
    if hum and hum.Parent then
        hum.WalkSpeed = origSpeed or 16
        local root = hum.Parent:FindFirstChild("HumanoidRootPart")
        if root then root.AssemblyLinearVelocity = Vector3.zero end
    end
    setBtnActive(tweenBtn, false)
end

local function startTween()
    local c = player.Character; if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    if not h or not r then return end
    
    hum = h
    origSpeed = h.WalkSpeed
    isTweening = true
    setBtnActive(tweenBtn, true)

    h.WalkSpeed = 0
    h:Move(Vector3.zero, false)

    task.spawn(function()
        local currentPos = r.Position
        local startY = currentPos.Y
        local midPos = Vector3.new(currentPos.X, startY, TARGET.Z)
        local finalPos = Vector3.new(TARGET.X, startY, TARGET.Z)
        
        -- BƯỚC 1: Tween ngang đến Z = 134
        if (currentPos - midPos).Magnitude > 1 then
            local dist1 = (currentPos - midPos).Magnitude
            local ti = TweenInfo.new(dist1 / TWEEN_SPEED, Enum.EasingStyle.Linear)
            local t = TweenService:Create(r, ti, {CFrame = CFrame.new(midPos)})
            activeTween = t
            t:Play()
            t.Completed:Wait()
        end

        if not isTweening then return end

        -- BƯỚC 2: Từ Z=134 đi đến X=-94
        if (midPos - finalPos).Magnitude > 1 then
            if tweenSuperEnabled then
                while (finalPos - r.Position).Magnitude > 1 do
                    if not isTweening then return end
                    
                    local cPos = r.Position
                    local dir = (finalPos - cPos).Unit
                    
                    -- 2.1: TP 80 studs
                    local tpDist = math.min(80, (finalPos - cPos).Magnitude)
                    r.CFrame = r.CFrame + (dir * tpDist)
                    if (finalPos - r.Position).Magnitude <= 1 then break end
                    
                    -- 2.2: Dừng 0.2s
                    task.wait(0.2)
                    if not isTweening then return end
                    
                    -- 2.3: Tween 120 speed trong 0.5s
                    local tSpeed = 120
                    local tTime = 0.5
                    local tDist = tSpeed * tTime
                    
                    if (finalPos - r.Position).Magnitude < tDist then
                        tDist = (finalPos - r.Position).Magnitude
                        tTime = tDist / tSpeed
                    end
                    
                    local stepTarget = r.Position + (dir * tDist)
                    local ti = TweenInfo.new(tTime, Enum.EasingStyle.Linear)
                    local t = TweenService:Create(r, ti, {CFrame = CFrame.new(stepTarget)})
                    activeTween = t
                    t:Play()
                    t.Completed:Wait()
                end
            else
                local dist2 = (midPos - finalPos).Magnitude
                local ti = TweenInfo.new(dist2 / TWEEN_SPEED, Enum.EasingStyle.Linear)
                local t = TweenService:Create(r, ti, {CFrame = CFrame.new(finalPos)})
                activeTween = t
                t:Play()
                t.Completed:Wait()
            end
        end
        
        if isTweening then stopTween() end
    end)
end

tweenBtn.MouseButton1Click:Connect(function()
    if isTweening then stopTween() else startTween() end
end)

