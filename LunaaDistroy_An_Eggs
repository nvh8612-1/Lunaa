            local delta = input.Position - dragStartHidden
            hMain.Position = UDim2.new(startPosHiddenSolo.X.Scale, startPosHiddenSolo.X.Offset + delta.X, startPosHiddenSolo.Y.Scale, startPosHiddenSolo.Y.Offset + delta.Y)
        end
    end
end)

