--══════════════════════ [8] LOGIC TWEEN LUNAA ══════════════════════
local activeTween, hum, origSpeed = nil, nil, nil
local isTweening = false

local function stopTween()
    isTweening = false
    if activeTween then
        activeTween:Cancel()
        activeTween = nil
    end
    if hum and hum.Parent then
        hum.WalkSpeed = origSpeed or 16
        local root = hum.Parent:FindFirstChild("HumanoidRootPart")
        if root then root.AssemblyLinearVelocity = Vector3.zero end
    end
    tweenBtn.Text = "Tween Lunaa"
    tweenBtn.TextColor3 = Color3.fromRGB(220, 180, 255)
    tweenBtn.BackgroundColor3 = Color3.fromRGB(25, 15, 40)
    tweenBtn:SetAttribute("Active", false)
end

local function startTween()
    local c = player.Character; if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    if not h or not r then return end
    
    hum = h
    origSpeed = h.WalkSpeed
    isTweening = true
    playBubble() -- Tiếng bỏng ỏng khi bay
    tweenBtn.Text = "Tweening..."
    tweenBtn.TextColor3 = Color3.fromRGB(0, 255, 255)
    tweenBtn.BackgroundColor3 = Color3.fromRGB(40, 80, 100)
    tweenBtn:SetAttribute("Active", true)

    h.WalkSpeed = 0
    h:Move(Vector3.zero, false)

    task.spawn(function()
        local currentPos = r.Position
        local startY = currentPos.Y
        
        local midPos = Vector3.new(currentPos.X, startY, TARGET.Z)
        local dist1 = (currentPos - midPos).Magnitude
        
        if dist1 > 1 then
            local t1 = TweenService:Create(r, TweenInfo.new(dist1 / TWEEN_SPEED, Enum.EasingStyle.Linear), {CFrame = CFrame.new(midPos)})
            activeTween = t1
            t1:Play()
            t1.Completed:Wait()
        end

        if not isTweening then return end

        local finalPos = Vector3.new(TARGET.X, startY, TARGET.Z)
        local dist2 = (midPos - finalPos).Magnitude
        
        if dist2 > 1 then
            local t2 = TweenService:Create(r, TweenInfo.new(dist2 / TWEEN_SPEED, Enum.EasingStyle.Linear), {CFrame = CFrame.new(finalPos)})
            activeTween = t2
            t2:Play()
            t2.Completed:Wait()
        end

        if isTweening then
            stopTween()
        end
    end)
end

tweenBtn.MouseButton1Click:Connect(function()
    if isTweening then 
        stopTween() 
    else 
        startTween() 
