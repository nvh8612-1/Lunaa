local function setupLine()
    if beam then beam:Destroy() end
    local r = getRoot(); if not r then return false end
    local a0 = Instance.new("Attachment"); a0.Parent = r
    beam = Instance.new("Beam")
    beam.Attachment0 = a0
    beam.Attachment1 = tgtAtt
    beam.Color = ColorSequence.new(LINE_COLOR)
    beam.LightEmission = 1
    beam.LightInfluence = 0
    beam.Width0 = 0.15 
    beam.Width1 = 0.15
    beam.FaceCamera = true
    beam.Parent = r
    return true
end

local function clearLine()
    if beam then
        local a0 = beam.Attachment0
        beam:Destroy(); beam = nil
        if a0 then a0:Destroy() end
    end
end

