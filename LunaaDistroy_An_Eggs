--══════════════════════ [13] LOGIC TWEEN LUNAA & LINE ══════════════════════
local activeTween, hum, origSpeed = nil, nil, nil
local isTweening = false

local function stopTween()
    isTweening = false
    if activeTween then activeTween:Cancel(); activeTween = nil end
    if hum and hum.Parent then
        hum.WalkSpeed = origSpeed or 16
        local root = hum.Parent:FindFirstChild("HumanoidRootPart")
        if root then root.AssemblyLinearVelocity = Vector3.zero end
    end
    setBtnActive(tweenBtn, false)
end

local function startTween()
    local c = player.Character; if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    if not h or not r then return end
    
    hum = h
    origSpeed = h.WalkSpeed
    isTweening = true
    playClick()
    setBtnActive(tweenBtn, true)

    h.WalkSpeed = 0
    h:Move(Vector3.zero, false)

    task.spawn(function()
        local currentPos = r.Position
        local startY = currentPos.Y
        local midPos = Vector3.new(currentPos.X, startY, TARGET.Z)
        local finalPos = Vector3.new(TARGET.X, startY, TARGET.Z)
        
        local function doMovement(targetPos)
            if not isTweening then return end
            local distance = (targetPos - r.Position).Magnitude
            
            if tweenSuperEnabled then
                local direction = (targetPos - r.Position).Unit
                local traveled = 0
                while traveled < distance do
                    if not isTweening then return end
                    local step = math.min(10, distance - traveled)
                    local stepTarget = r.Position + direction * step
                    local ti = TweenInfo.new(step / TWEEN_SPEED, Enum.EasingStyle.Linear)
                    local t = TweenService:Create(r, ti, {CFrame = CFrame.new(stepTarget)})
                    t:Play()
                    t.Completed:Wait()
                    traveled += step
                end
            else
                local ti = TweenInfo.new(distance / TWEEN_SPEED, Enum.EasingStyle.Linear)
                local t = TweenService:Create(r, ti, {CFrame = CFrame.new(targetPos)})
                activeTween = t
                t:Play()
                t.Completed:Wait()
            end
        end

        if (currentPos - midPos).Magnitude > 1 then doMovement(midPos) end
        if isTweening and (midPos - finalPos).Magnitude > 1 then doMovement(finalPos) end
        if isTweening then stopTween() end
    end)
end

tweenBtn.MouseButton1Click:Connect(function()
    if isTweening then stopTween() else startTween() end
end)

-- Logic Line
local lineOn, beam = false, nil
local function getRoot()
    local c = player.Character
    if not c then return nil end
    return c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso")
end
local tgtAtt = Instance.new("Attachment")
tgtAtt.WorldPosition = TARGET
tgtAtt.Parent = Workspace.Terrain

local function setupLine()
    if beam then beam:Destroy() end
    local r = getRoot(); if not r then return false end
    local a0 = Instance.new("Attachment"); a0.Parent = r
    beam = Instance.new("Beam")
    beam.Attachment0 = a0
    beam.Attachment1 = tgtAtt
    beam.Color = ColorSequence.new(LINE_COLOR)
    beam.LightEmission = 1
    beam.LightInfluence = 0
    beam.Width0 = 0.15 
    beam.Width1 = 0.15
    beam.FaceCamera = true
    beam.Parent = r
    return true
end

local function clearLine()
    if beam then
        local a0 = beam.Attachment0
        beam:Destroy(); beam = nil
        if a0 then a0:Destroy() end
    end
end

lineBtn.MouseButton1Click:Connect(function()
    lineOn = not lineOn
    playClick()
    if lineOn and setupLine() then
        setBtnActive(lineBtn, true)
    else
        lineOn = false; clearLine()
        setBtnActive(lineBtn, false)
    end
end)

