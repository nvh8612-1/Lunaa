--══════════════════════ [4] LOGIC ESP LINE ══════════════════════
local lineOn, beam = false, nil
local function getRoot()
    local c = player.Character
    if not c then return nil end
    return c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso")
end

local tgtAtt = Instance.new("Attachment")
tgtAtt.WorldPosition = TARGET
tgtAtt.Parent = Workspace.Terrain

local function setupLine()
    if beam then beam:Destroy() end
    local r = getRoot(); if not r then return false end
    local a0 = Instance.new("Attachment"); a0.Parent = r
    beam = Instance.new("Beam")
    beam.Attachment0 = a0
    beam.Attachment1 = tgtAtt
    beam.Color = ColorSequence.new(LINE_COLOR)
    beam.LightEmission = 1
    beam.LightInfluence = 0
    beam.Width0 = 0.15 
    beam.Width1 = 0.15
    beam.FaceCamera = true
    beam.Parent = r
    return true
end

local function clearLine()
    if beam then
        local a0 = beam.Attachment0
        beam:Destroy(); beam = nil
        if a0 then a0:Destroy() end
    end
end

lineBtn.MouseButton1Click:Connect(function()
    lineOn = not lineOn
    if lineOn and setupLine() then
        lineBtn.Text = "Line [ON]"
        lineBtn.TextColor3 = Color3.fromRGB(0, 255, 255)
    else
        lineOn = false; clearLine()
        lineBtn.Text = "Lunaa Line"
        lineBtn.TextColor3 = Color3.fromRGB(200, 240, 255)
    end
end)

player.CharacterAdded:Connect(function(c)
    c:WaitForChild("HumanoidRootPart", 10)
    if lineOn then task.wait(0.2); setupLine() end
end)

--══════════════════════ [5] LOGIC TWEEN LUNAA ══════════════════════
local activeTween, hum, origSpeed = nil, nil, nil
local isTweening = false

local function stopTween()
    isTweening = false
    if activeTween then
        activeTween:Cancel()
        activeTween = nil
    end
    if hum and hum.Parent then
        hum.WalkSpeed = origSpeed or 16
        local root = hum.Parent:FindFirstChild("HumanoidRootPart")
        if root then root.AssemblyLinearVelocity = Vector3.zero end
    end
    tweenBtn.Text = "Tween Lunaa"
    tweenBtn.TextColor3 = Color3.fromRGB(200, 240, 255)
end

local function startTween()
    local c = player.Character; if not c then return end
    local h = c:FindFirstChildOfClass("Humanoid")
    local r = c:FindFirstChild("HumanoidRootPart")
    if not h or not r then return end
    
    hum = h
    origSpeed = h.WalkSpeed
    isTweening = true
    tweenBtn.Text = "Tweening..."
    tweenBtn.TextColor3 = Color3.fromRGB(255, 100, 255)

    h.WalkSpeed = 0
    h:Move(Vector3.zero, false)

    task.spawn(function()
        local currentPos = r.Position
        local startY = currentPos.Y
        
        -- CHẶNG 1: Z = 134 trước
        local midPos = Vector3.new(currentPos.X, startY, TARGET.Z)
        local dist1 = (currentPos - midPos).Magnitude
        
        if dist1 > 1 then
            local t1 = TweenService:Create(r, TweenInfo.new(dist1 / TWEEN_SPEED, Enum.EasingStyle.Linear), {CFrame = CFrame.new(midPos)})
            activeTween = t1
            t1:Play()
            t1.Completed:Wait()
        end

        if not isTweening then return end

        -- CHẶNG 2: X = -94
        local finalPos = Vector3.new(TARGET.X, startY, TARGET.Z)
        local dist2 = (midPos - finalPos).Magnitude
        
        if dist2 > 1 then
            local t2 = TweenService:Create(r, TweenInfo.new(dist2 / TWEEN_SPEED, Enum.EasingStyle.Linear), {CFrame = CFrame.new(finalPos)})
            activeTween = t2
            t2:Play()
            t2.Completed:Wait()
        end

        if isTweening then
            stopTween()
        end
    end)
end

tweenBtn.MouseButton1Click:Connect(function()
    if isTweening then 
        stopTween() 
    else 
        startTween() 
    end
end)

player.CharacterAdded:Connect(stopTween)
