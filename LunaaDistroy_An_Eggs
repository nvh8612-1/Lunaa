--══════════════════════ [1] CLEANER CHẠY NGẦM ══════════════════════
task.spawn(function()
    local Build = Workspace:WaitForChild("Build", 30)
    if not Build then return end
    local ZoneBuilds = Build:WaitForChild("ZoneBuilds", 30)
    if not ZoneBuilds then return end

    local function isZone(n) return n:match(ZonePattern) ~= nil end
    local function hasAnim(i)
        if i.Name == "AnimSaves" then return true end
        return i:FindFirstChild("AnimSaves", true) ~= nil
    end

    local stats = { zones = 0, top = 0, children = 0 }

    for _, c in ipairs(ZoneBuilds:GetChildren()) do
        if not (KeepTopNames[c.Name] or isZone(c.Name)) then
            c:Destroy(); stats.top += 1
        end
    end

    for _, zone in ipairs(ZoneBuilds:GetChildren()) do
        if not isZone(zone.Name) then continue end
        stats.zones += 1
        for _, c in ipairs(zone:GetChildren()) do
            local keep = false
            if c.Name == "Chicken" and hasAnim(c) then
                keep = true
                if ChickenOnlyAnimSaves then
                    for _, sub in ipairs(c:GetChildren()) do
                        if sub.Name ~= "AnimSaves" then
                            sub:Destroy(); stats.children += 1
                        end
                    end
                end
            elseif c.Name == "Eggs" and KeepEggs then
                keep = true
            elseif hasAnim(c) then
                keep = true
            end
            if not keep then c:Destroy(); stats.children += 1 end
        end
    end
    print(("[Lunaa] Đã xóa map ngầm: zones=%d top=%d children=%d"):format(stats.zones, stats.top, stats.children))
end)

